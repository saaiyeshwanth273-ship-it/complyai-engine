# ====================================================================
# COMPLYAI REGULATORY INTELLIGENCE ENGINE - ENVIRONMENT CONFIGURATION
# ====================================================================

# Gemma Model Configuration
GEMMA_MODEL=google/gemma-2-9b-it
GEMMA_QUANTIZATION=4bit
GEMMA_MAX_TOKENS=4096
GEMMA_TEMPERATURE=0.1
GEMMA_INFERENCE_BACKEND=mock  # mock, ollama, transformers, vllm, vertex

# Database Configuration (PostgreSQL 15+ with pgvector)
DATABASE_URL=postgresql://complyai_user:complyai_secret@localhost:5432/complyai_regulatory_db
PGVECTOR_ENABLED=true

# Embedding Configuration
EMBEDDING_MODEL=legal-bert-multilingual-v1
EMBEDDING_DIMENSION=384

# Hybrid RAG Configuration
BM25_K1=1.5
BM25_B=0.75
TOP_K_RETRIEVAL=10
RERANKER_TOP_N=5

# Grounding & Verification Thresholds
GROUNDING_THRESHOLD=0.75
CITATION_MATCH_THRESHOLD=0.70
STRICT_CITATION_VERIFICATION=true
HUMAN_REVIEW_RISK_THRESHOLD=HIGH

# Application Metadata
ENGINE_VERSION=1.0.0
PROMPT_VERSION=2026.1
KNOWLEDGE_BASE_VERSION=v1.2-india-intl

